<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/1style.css" />
    <title>Личный кабинет | Car Service</title>
    <style>
        /* Specific Dashboard Styles requiring no extra CSS file */
        .dashboard-container {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 40px;
            margin-top: 40px;
            min-height: 80vh;
        }

        .sidebar {
            background: var(--card-bg);
            backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 30px;
            height: fit-content;
            text-align: center;
        }

        .profile-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,0.1);
            margin-bottom: 20px;
            padding: 10px;
        }

        .profile-name {
            font-size: 1.2rem;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .profile-phone-box {
            background: rgba(0,0,0,0.2);
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 30px;
            font-family: monospace;
            font-size: 1.1rem;
            color: var(--text-muted);
        }

        .dashboard-main {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: 2rem;
            margin-bottom: 20px;
            border-bottom: 2px solid var(--glass-border);
            padding-bottom: 10px;
        }

        .cars-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .car-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            padding: 20px;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .car-card:hover {
            transform: translateY(-5px);
            background: rgba(255,255,255,0.08);
        }

        .car-icon {
            width: 50px;
            height: 50px;
            background: var(--glass-bg); /* Transparent glass background */
            backdrop-filter: blur(5px);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: var(--accent-color); /* Primary icon color */
            transition: var(--transition);
        }
        
        .car-card:hover .car-icon {
            border-color: var(--accent-color);
            box-shadow: 0 0 15px rgba(255, 174, 82, 0.2);
            transform: scale(1.05);
        }

        .car-info strong {
            display: block;
            font-size: 1.1rem;
        }

        .car-info span {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .car-actions {
            margin-left: auto;
            display: flex;
            gap: 10px;
        }

        .car-action-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
            font-size: 1.2rem;
            padding: 0;
        }

        .car-action-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.1);
        }

        .car-action-btn.edit:hover {
            border-color: var(--accent-color);
            box-shadow: 0 0 10px rgba(255, 174, 82, 0.2);
        }

        .car-action-btn.delete:hover {
            border-color: #ff4d4d;
            box-shadow: 0 0 10px rgba(255, 77, 77, 0.2);
        }

        /* SVG Icon overrides */
        .car-icon .icon {
            width: 32px;
            height: 32px;
            stroke: var(--accent-color);
            filter: drop-shadow(0 0 4px rgba(255, 174, 82, 0.4));
        }

        .car-action-btn .icon {
            width: 18px;
            height: 18px;
        }

        .car-icon {
            cursor: pointer;
        }

        /* Modal styling */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .modal-overlay.active {
            display: flex;
            opacity: 1;
        }

        .modal-content {
            width: 90%;
            max-width: 450px;
            padding: 30px;
            position: relative;
            transform: translateY(20px);
            transition: transform 0.3s ease;
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
        }

        .modal-overlay.active .modal-content {
            transform: translateY(0);
        }

        .modal-close {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1.5rem;
            cursor: pointer;
            transition: var(--transition);
        }

        .modal-close:hover {
            color: white;
        }

        .modal-header {
            text-align: center;
            margin-bottom: 25px;
        }

        .modal-icon-container {
            width: 64px;
            height: 64px;
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            color: var(--accent-color);
            box-shadow: 0 0 20px rgba(255, 174, 82, 0.2);
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .info-item {
            padding: 12px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .info-item label {
            display: block;
            font-size: 0.7rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .info-item span {
            font-family: var(--font-display);
            font-size: 0.85rem;
            word-break: break-all;
        }

        .order-view-link .icon {
            width: 20px;
            height: 20px;
        }

        .add-car-btn {
            background: transparent;
            border: 2px dashed var(--glass-border);
            border-radius: 15px;
            color: var(--text-muted);
            font-size: 1rem;
            cursor: pointer;
            transition: var(--transition);
            height: 100%;
            min-height: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .add-car-btn:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
            background: rgba(255, 174, 82, 0.05);
        }

        .back-link {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            font-size: 0.9rem;
        }
        
        .back-link:hover {
            color: var(--text-color);
        }

        @media (max-width: 768px) {
            .dashboard-container {
                grid-template-columns: 1fr;
            }
        }

        /* Tabs and Menu Buttons */
        .menu-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-muted);
            cursor: pointer;
            transition: var(--transition);
            font-size: 0.95rem;
            font-weight: 500;
        }

        .menu-btn:hover {
            background: rgba(255,255,255,0.08);
            color: white;
            border-color: rgba(255,255,255,0.2);
        }

        .menu-btn.active {
            background: var(--accent-gradient);
            color: white;
            border: none;
            box-shadow: 0 5px 15px rgba(255, 174, 82, 0.2);
        }

        .menu-btn .icon {
            width: 18px;
            height: 18px;
        }

        .tab-content {
            animation: fadeIn 0.4s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
  </head>
  <body>
    <header class="header container" style="backdrop-filter: none; border-bottom: 1px solid var(--glass-border); margin-bottom: 20px;">
        <div class="header-left">
            <button class="hamburger-btn" id="hamburgerBtn" aria-label="Меню" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <div class="logo-container">
                <img src="/img/svg/Logo.svg" alt="Car Service Logo" class="logo-img" />
                <div class="logo-text">Car Service</div>
            </div>
        </div>
        <div class="auth-buttons">
            <a href="/" class="btn btn-login" style="font-size: 0.8rem; padding: 8px 16px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                На главную
            </a>
        </div>
    </header>

    <div class="container dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <img src="/img/svg/acc_logo.svg" alt="Profile" class="profile-img" onerror="this.src='https://ui-avatars.com/api/?name=User&background=random'" />
            <h2 class="profile-name"><%= fio %></h2>
            
            <div class="info-card">
                <div class="info-label">Телефон</div>
                <div class="info-value"><%= phone %></div>
            </div>

            <div class="info-card">
                <div class="info-label">Email</div>
                <div class="info-value"><%= email %></div>
            </div>

            <div class="info-card">
                <div class="info-label">Дата регистрации</div>
                <div class="info-value"><%= date %></div>
            </div>

            <div class="sidebar-menu" style="margin-top: 20px; display: flex; flex-direction: column; gap: 10px;">
                <button class="menu-btn active" onclick="showTab('current')">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                    Текущие заказы
                </button>
                <button class="menu-btn" onclick="showTab('history')">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
                    История заказов
                </button>
            </div>

            <div class="info-card highlight-card" style="margin-top: 20px;">
                <div class="info-label">Общая стоимость заказов</div>
                <div class="info-value"><%= cost %> ₽</div>
            </div>
            
            <a href="/auth/logout" class="btn btn-login logout-btn" style="background: rgba(220, 53, 69, 0.1); border-color: rgba(220, 53, 69, 0.3); color: #ff4d4d; margin-top: 20px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Выйти
            </a>
        </aside>

        <!-- Main Content -->
        <main class="dashboard-main">
            <section>
                <h1 class="section-title">Ваши автомобили</h1>
                <div class="cars-grid">
                    <!-- Car Cards -->
                    <% cars.forEach(car => { %>
                    <div class="car-card" 
                         data-mark="<%= car.mark %>" 
                         data-model="<%= car.model %>" 
                         data-year="<%= car.year %>" 
                         data-plate="<%= car.gos_nomer %>" 
                         data-vin="<%= car.wincode %>">
                        <div class="car-icon" title="Посмотреть информацию">
                            <!-- Custom car silhouette exactly matching the provided image -->
                            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                <path d="M17.5 5h-11c-.6 0-1.1.4-1.3 1L4 10.5c-1.1.2-2 1.2-2 2.5V17c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-1h14v1c0 .6.4 1 1 1h1c.6 0 1-.4 1-1v-4c0-1.3-.9-2.3-2-2.5L18.8 6c-.2-.6-.7-1-1.3-1zM6.5 14.5c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5zm11 0c-.8 0-1.5-.7-1.5-1.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5-.7 1.5-1.5 1.5zM16 10H8l.8-3.5h6.4L16 10zm-1.5 4.5h-5v-1.5h5v1.5z" />
                            </svg>
                        </div>
                        <div class="car-info">
                            <strong><%= car.mark %></strong>
                            <span><%= car.model %></span>
                        </div>
                        <div class="car-actions">
                            <a href="/car/edit/<%= car.car_id %>" class="car-action-btn edit" title="Редактировать">
                                <svg class="icon" viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                            </a>
                            <form action="/car/delete/<%= car.car_id %>" method="POST" onsubmit="return confirm('Удалить этот автомобиль?')">
                                <button type="submit" class="car-action-btn delete" title="Удалить">
                                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }); %>
                    
                    <!-- Add Car Button -->
                    <form action="/car" method="GET" style="display: contents;">
                        <button type="submit" class="add-car-btn">
                            <span style="font-size: 2rem;">+</span>
                            <span>Добавить авто</span>
                        </button>
                    </form>
                </div>
            </section>
            <section id="current-orders-section" class="tab-content active">
                <h1 class="section-title">Текущие заказы</h1>
                <div class="orders-history">
                    <% 
                        const activeOrders = orders.filter(o => !['closed', 'Заказ выполнен', 'Заказ отменён'].includes(o.order_status));
                        if (activeOrders.length > 0) { 
                    %>
                        <div class="orders-table-wrapper">
                            <table class="orders-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Дата</th>
                                        <th>Сумма</th>
                                        <th>Статус</th>
                                        <th>Просмотреть</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% activeOrders.forEach(order => { %>
                                    <tr>
                                        <td>#<%= order.order_id %></td>
                                        <td><%= order.servis_data %></td>
                                        <td class="order-amount"><%= order.total_amount %> ₽</td>
                                        <td>
                                            <% 
                                                let statusClass = 'status-active';
                                                let statusText = order.order_status;
                                                
                                                if (order.order_status === 'В обработке' || order.order_status === 'В работе') {
                                                    statusClass = 'status-active';
                                                    statusText = 'В работе';
                                                } else if (order.order_status === 'Мастер выехал') {
                                                    statusClass = 'status-active';
                                                    statusText = 'Мастер выехал';
                                                }
                                            %>
                                            <span class="status-badge <%= statusClass %>">
                                                <%= statusText %>
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <a href="/order-details/<%= order.order_id %>" class="order-view-link" title="Просмотреть">
                                                <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-history">
                            <p>У вас пока нет текущих заказов.</p>
                            <a href="/zakaz" class="btn btn-cta" style="padding: 10px 20px; font-size: 0.9rem; margin-top:15px;">Записаться на сервис</a>
                        </div>
                    <% } %>
                </div>
            </section>

            <section id="history-orders-section" class="tab-content" style="display: none;">
                <h1 class="section-title">История заказов</h1>
                <div class="orders-history">
                    <% 
                        const historyOrders = orders.filter(o => ['closed', 'Заказ выполнен', 'Заказ отменён'].includes(o.order_status));
                        if (historyOrders.length > 0) { 
                    %>
                        <div class="orders-table-wrapper">
                            <table class="orders-table">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Дата</th>
                                        <th>Сумма</th>
                                        <th>Статус</th>
                                        <th>Просмотреть</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% historyOrders.forEach(order => { %>
                                    <tr>
                                        <td>#<%= order.order_id %></td>
                                        <td><%= order.servis_data %></td>
                                        <td class="order-amount"><%= order.total_amount %> ₽</td>
                                        <td>
                                            <% 
                                                let statusClass = 'status-closed';
                                                let statusText = order.order_status;
                                                
                                                if (order.order_status === 'Заказ отменён') {
                                                    statusClass = 'status-cancelled';
                                                    statusText = 'Заказ отменён';
                                                } else if (order.order_status === 'Заказ выполнен') {
                                                    statusClass = 'status-closed';
                                                    statusText = 'Заказ выполнен';
                                                } else if (order.order_status === 'closed') {
                                                    statusClass = 'status-closed';
                                                    statusText = 'Завершен';
                                                }
                                            %>
                                            <span class="status-badge <%= statusClass %>">
                                                <%= statusText %>
                                            </span>
                                        </td>
                                        <td style="text-align: center;">
                                            <a href="/order-details/<%= order.order_id %>" class="order-view-link" title="Просмотреть">
                                                <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                            </a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="empty-history">
                            <p>История пуста.</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </main>
    </div>

    <style>
        /* Extra styles inline for quick adjustment, can move to 1style.css later */
        .info-card {
            background: rgba(0,0,0,0.2);
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 15px;
            text-align: left;
        }

        .highlight-card {
            background: rgba(255, 174, 82, 0.1);
            border: 1px solid var(--accent-color);
        }

        .info-label {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .info-value {
            font-family: monospace;
            font-size: 1rem;
            word-break: break-all;
        }

        .logout-btn {
            width: 100%; 
            margin-top: 20px;
            box-sizing: border-box; /* Fixes overflow issue */
            display: flex; /* Ensures text centering */
            justify-content: center;
        }

        .orders-table-wrapper {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 15px;
            overflow: hidden;
            margin-top: 20px;
        }

        .orders-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .orders-table th, .orders-table td {
            padding: 15px 20px;
            border-bottom: 1px solid var(--glass-border);
        }

        .orders-table th {
            background: rgba(255, 255, 255, 0.03);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
        }

        .order-amount {
            color: var(--accent-color);
            font-weight: 700;
        }

        .status-badge {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-active {
            background: rgba(108, 99, 255, 0.2);
            color: #6C63FF;
            border: 1px solid rgba(108, 99, 255, 0.3);
        }

        .status-closed {
            background: rgba(40, 167, 69, 0.2);
            color: #28a745;
            border: 1px solid rgba(40, 167, 69, 0.3);
        }

        .status-cancelled {
            background: rgba(220, 53, 69, 0.2);
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

        .order-view-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            text-decoration: none;
            font-size: 1.2rem;
            transition: var(--transition);
        }

        .order-view-link:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: scale(1.1);
            border-color: var(--accent-color);
        }

        .orders-table th:nth-child(1) { width: 100px; }
        .orders-table th:nth-child(2) { width: 150px; }
        .orders-table th:nth-child(3) { width: 130px; }
        .orders-table th:nth-child(4) { width: 150px; }
        .orders-table th:nth-child(5) { width: 100px; text-align: center; }

        .empty-history {
            text-align: center;
            padding: 40px;
            background: rgba(255,255,255,0.02);
