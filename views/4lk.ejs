    <script>
    (function() {
        // Car Details Modal Logic
        const modal = document.getElementById('carModalOverlay');
        const closeModalBtn = document.getElementById('closeCarModal');
        
        document.querySelectorAll('.car-icon').forEach(icon => {
            icon.addEventListener('click', () => {
                const card = icon.closest('.car-card');
                const mark = card.dataset.mark;
                const model = card.dataset.model;
                const year = card.dataset.year;
                const plate = card.dataset.plate;
                const vin = card.dataset.vin;
                
                document.getElementById('modalCarTitle').textContent = `${mark} ${model}`;
                document.getElementById('modalCarYear').textContent = year ? new Date(year).getFullYear() : '-';
                document.getElementById('modalCarPlate').textContent = plate || '-';
                document.getElementById('modalCarVin').textContent = vin || '-';
                
                modal.classList.add('active');
                document.body.style.overflow = 'hidden';
            });
        });

        function closeModal() {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
        if (modal) modal.addEventListener('click', (e) => {
            if (e.target.id === 'carModalOverlay') closeModal();
        });

        // Hamburger Menu Logic
        const btn = document.getElementById('hamburgerBtn');
        const nav = document.getElementById('sideNav');
        const overlay = document.getElementById('navOverlay');
        const closeBtn = document.getElementById('sideNavClose');

        if (!btn || !nav || !overlay || !closeBtn) return;

        function openNav() {
            btn.classList.add('open');
            nav.classList.add('open');
            overlay.classList.add('visible');
            btn.setAttribute('aria-expanded', 'true');
            nav.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeNav() {
            btn.classList.remove('open');
            nav.classList.remove('open');
            overlay.classList.remove('visible');
            btn.setAttribute('aria-expanded', 'false');
            nav.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        btn.addEventListener('click', () => nav.classList.contains('open') ? closeNav() : openNav());
        closeBtn.addEventListener('click', closeNav);
        overlay.addEventListener('click', closeNav);

        // Close on Escape
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeNav(); });

        // Close when clicking link
        document.querySelectorAll('.side-nav-link').forEach(link => {
            link.addEventListener('click', closeNav);
        });
    })();
    </script>
      <script>
        function showTab(tabName) {
            // Hide all sections
            document.querySelectorAll('.tab-content').forEach(section => {
                section.style.display = 'none';
                section.classList.remove('active');
            });

            // Deactivate all buttons
            document.querySelectorAll('.menu-btn').forEach(btn => {
                btn.classList.remove('active');
            });

            // Show selected section
            const targetSection = document.getElementById(tabName + '-orders-section');
            if (targetSection) {
                targetSection.style.display = 'block';
                targetSection.classList.add('active');
            }

            // Activate clicked button
            event.currentTarget.classList.add('active');
        }

        // Hamburger Menu Logic
        const hamburgerBtn = document.getElementById('hamburgerBtn');
        const sidebar = document.querySelector('.sidebar');
        
        if (hamburgerBtn) {
            hamburgerBtn.onclick = () => {
                const expanded = hamburgerBtn.getAttribute('aria-expanded') === 'true';
                hamburgerBtn.setAttribute('aria-expanded', !expanded);
                sidebar.classList.toggle('open');
            };
        }
    </script>
