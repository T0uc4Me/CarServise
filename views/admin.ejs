<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/admin-new.css" />
    <style>
      .admin-tabs {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
        background: rgba(255, 255, 255, 0.03);
        padding: 10px;
        border-radius: 16px;
        border: 1px solid var(--admin-border);
      }
      .tab-btn {
        padding: 12px 24px;
        border-radius: 12px;
        background: transparent;
        color: var(--admin-text-muted);
        border: none;
        cursor: pointer;
        font-family: var(--font-display);
        font-size: 0.9rem;
        transition: var(--transition);
      }
      .tab-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--admin-text);
      }
      .tab-btn.active {
        background: var(--admin-primary);
        color: white;
        box-shadow: 0 4px 15px rgba(108, 99, 255, 0.3);
      }
      .tab-panel {
        display: none;
        grid-column: 1 / -1;
      }
      .tab-panel.active {
        display: grid;
        grid-template-columns: 1fr;
        gap: 30px;
      }
      /* Adjust main to be single column as tabs will separate them */
      .admin-main {
        grid-template-columns: 1fr;
      }
      .master-option {
          background-color: #1a1a2e !important;
          color: #ffffff !important;
      }
      select.master-select {
          background: rgba(255, 255, 255, 0.05);
          border: 1px solid rgba(255, 255, 255, 0.15);
          color: #fff;
          border-radius: 10px;
          padding: 8px 12px;
          font-size: 0.82rem;
          cursor: pointer;
          outline: none;
          min-width: 180px;
      }
      .unassigned-dot {
          width: 8px;
          height: 8px;
          background-color: #ff4d4d;
          border-radius: 50%;
          display: inline-block;
          box-shadow: 0 0 8px rgba(255, 77, 77, 0.6);
      }
    </style>
    <title>Администратор</title>
  </head>
  <body>
    <header>
      <div class="header-container">
        <h1>Личный кабинет администратора</h1>
        <div class="user-controls">
          <span class="user-role">Роль: <%= userRole %></span>
          <button id="exit">
            <a href="/"><h1>выход</h1></a>
          </button>
        </div>
      </div>
    </header>
    <main class="admin-main">
      <div class="admin-tabs">
        <button class="tab-btn active" data-tab="orders">Активные заказы</button>
        <button class="tab-btn" data-tab="inventory">Инвентарь</button>
        <button class="tab-btn" data-tab="support">Поддержка</button>
      </div>

      <div id="orders-tab" class="tab-panel active">
        <section class="orders-section">
          <h2>Активные заказы</h2>
          <ul class="orders-list">
            <% activeOrders.forEach(order => { %>
            <li class="order-item">
              <div style="display:flex; flex-direction:column; gap:4px; flex:1;">
                <span style="font-weight:700;">Заказ #<%= order.order_id %></span>
                <span style="font-size:0.8rem; color:rgba(255,255,255,0.5);">Статус: <%= order.order_status %></span>
              </div>
              <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                <% if (!order.Employes_employes_id) { %>
                    <span class="unassigned-dot" title="Мастер не назначен"></span>
                <% } %>
                <!-- Dropdown назначения мастера -->
                <select class="master-select" data-order-id="<%= order.order_id %>" data-current-master="<%= order.Employes_employes_id %>">
                  <option value="" class="master-option">— Назначить мастера —</option>
                </select>
                <button class="assign-master-button view-button" data-order-id="<%= order.order_id %>">
                  Назначить
                </button>
                <a href="/order-details/<%= order.order_id %>" class="view-button">Просмотреть</a>
                <button class="close-order-button" data-order-id="<%= order.order_id %>">Закрыть</button>
              </div>
            </li>
            <% }); %>
          </ul>
        </section>
      </div>

      <div id="inventory-tab" class="tab-panel">
        <section class="inventory-section">
          <h2>Инвентарь</h2>
          <table class="inventory-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Количество</th>
                <th>Цена</th>
                <th>Действие</th>
              </tr>
            </thead>
            <tbody>
              <% inventory.forEach(item => { %>
              <tr data-id="<%= item.inventory_id %>">
                <td class="editable-cell" data-field="inventory_id">
                    <span class="cell-value text-muted" style="font-weight: 700;"><%= item.inventory_id %></span>
                </td>
                <td class="editable-cell" data-field="inventory_name">
                    <span class="cell-value"><%= item.inventory_name %></span>
                </td>
                <td class="editable-cell" data-field="quantity_in_stock">
                    <span class="cell-value"><%= item.quantity_in_stock %></span>
                </td>
                <td class="editable-cell" data-field="inventory_price">
                    <span class="cell-value"><%= item.inventory_price %></span> ₽
                </td>
                <td style="white-space: nowrap;">
                  <button class="desc-button" data-id="<%= item.inventory_id %>" data-desc="<%= item.inventory_discription || '' %>">
                    Описание
                  </button>
                  <button
                    class="delete-item-button"
                    data-inventory-id="<%= item.inventory_id %>"
                  >
                    Удалить
                  </button>
                </td>
              </tr>
              <% }); %>
            </tbody>
          </table>
          <button id="add-item-button" class="add-button" style="margin-top: 20px;">Добавить предмет</button>
        </section>
      </div>
      
      <div id="support-tab" class="tab-panel">
        <section class="admin-chat-section">
          <h2>Активные тикеты</h2>
          <div class="tickets-grid" id="ticketsGrid">
              <div style="padding:16px; color: rgba(255,255,255,0.4); text-align:center; grid-column: 1/-1;">Загрузка активных сессий...</div>
          </div>
        </section>
      </div>
    </main>

    <!-- Контейнер для плавающих окон чата -->
    <div class="admin-chat-windows-container" id="adminChatWindows"></div>

    <div id="add-item-popup" class="popup">
      <div class="popup-content">
        <div class="popup-content__header">
          <span class="close">&times;</span>
          <h2>Добавить предмет в инвентарь</h2>
        </div>
        <form class="popup__add-object" id="add-item-form" action="/inventory" method="POST">
          <label for="inventory_name">Название:</label>
          <input type="text" id="inventory_name" name="inventory_name" required />
          <label for="quantity_in_stock">Количество:</label>
          <input type="number" id="quantity_in_stock" name="quantity_in_stock" required />
          <label for="inventory_price">Цена:</label>
          <input type="number" id="inventory_price" name="inventory_price" required />
          <input type="hidden" name="employes_employes_id" value="<%= userId %>" />
          <button type="submit">Добавить</button>
        </form>
      </div>
    </div>

    <!-- Popup для редактирования описания -->
    <div id="description-popup" class="popup">
      <div class="popup-content">
        <div class="popup-content__header">
          <span class="close-desc" style="position: absolute; top: 25px; right: 30px; font-size: 2rem; color: var(--admin-text-muted); cursor: pointer;">&times;</span>
          <h2>Описание товара</h2>
        </div>
        <div style="margin-top: 20px;">
          <textarea id="edit-description-text" class="popup-textarea" placeholder="Введите описание товара..."></textarea>
          <button id="save-description-btn" class="save-desc-btn">Сохранить описание</button>
        </div>
      </div>
    </div>

    <script>
      // ===== 1. EXISTING ADMIN SCRIPTS (Delete, Close Order, Add Item) =====
      const deleteItemButtons = document.querySelectorAll(".delete-item-button");
      deleteItemButtons.forEach(button => {
        button.addEventListener("click", async event => {
          const inventoryId = button.getAttribute("data-inventory-id");
          const confirmDelete = confirm(`Вы уверены, что хотите удалить предмет с ID: ${inventoryId}?`);
          if (confirmDelete) {
            try {
              const response = await fetch(`/admin/delete-item/${inventoryId}`, { method: "DELETE" });
              if (response.ok) { alert("Предмет успешно удалён."); window.location.reload(); }
              else alert("Не удалось удалить предмет.");
            } catch (error) { console.error("Ошибка при удалении предмета:", error); }
          }
        });
      });

      const addItemPopup = document.getElementById("add-item-popup");
      const addItemBtn = document.getElementById("add-item-button");
      const closeAddItem = document.querySelector("#add-item-popup .close");
      addItemBtn.onclick = () => { addItemPopup.style.display = "block"; };
      closeAddItem.onclick = () => { addItemPopup.style.display = "none"; };

      const closeOrderButtons = document.querySelectorAll(".close-order-button");
      closeOrderButtons.forEach(button => {
        button.addEventListener("click", async event => {
          const orderId = button.getAttribute("data-order-id");
          const confirmClose = confirm(`Вы уверены, что хотите закрыть заказ ID: ${orderId}?`);
          if (confirmClose) {
            try {
              const response = await fetch(`/admin/close-order/${orderId}`, { method: "PUT" });
              if (response.ok) { alert("Заказ успешно закрыт."); window.location.reload(); }
              else alert("Не удалось закрыть заказ.");
            } catch (error) { console.error("Ошибка при закрытии заказа:", error); }
          }
        });
      });

      // ===== 2. MASTER ASSIGN SCRIPTS =====
      (async function loadMasters() {
        try {
          const res = await fetch('/admin/masters');
          const masters = await res.json();
          const selects = document.querySelectorAll('.master-select');
          selects.forEach(sel => {
            const currentMasterId = sel.getAttribute('data-current-master');
            masters.forEach(m => {
              const opt = document.createElement('option');
              opt.value = m.employes_id;
              opt.textContent = `${m.first_name} ${m.last_name}`;
              opt.className = 'master-option';
              if (currentMasterId && m.employes_id == currentMasterId) {
                opt.selected = true;
              }
              sel.appendChild(opt);
            });
          });
        } catch(e) { console.error('Ошибка загрузки мастеров:', e); }
      })();

      document.querySelectorAll('.assign-master-button').forEach(btn => {
        btn.addEventListener('click', async () => {
          const orderId = btn.getAttribute('data-order-id');
          const sel = document.querySelector(`.master-select[data-order-id="${orderId}"]`);
          const masterId = sel ? sel.value : '';
          if (!masterId) { alert('Выберите мастера из списка.'); return; }
          try {
            const res = await fetch(`/admin/assign-master/${orderId}`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ masterId: parseInt(masterId) })
            });
            const data = await res.json();
            if (res.ok) { alert(`Мастер успешно назначен на заказ #${orderId}`); }
            else { alert('Ошибка: ' + (data.error || 'неизвестная ошибка')); }
          } catch(e) { console.error('Ошибка назначения мастера:', e); }
        });
      });

      // ===== 3. INVENTORY EDITING SCRIPTS =====
      const descPopup = document.getElementById('description-popup');
      const closeDesc = document.querySelector('.close-desc');
      const saveDescBtn = document.getElementById('save-description-btn');
      const descTextarea = document.getElementById('edit-description-text');
      let currentEditingId = null;

      // Inline editing for ID, Name, quantity and price
      document.querySelectorAll('.editable-cell').forEach(cell => {
          cell.addEventListener('click', function() {
              if (this.querySelector('input')) return;

              const field = this.getAttribute('data-field');
              const valueSpan = this.querySelector('.cell-value');
              const originalValue = valueSpan.textContent.trim();
              const tr = this.closest('tr');
              const originalId = tr.getAttribute('data-id');

              const input = document.createElement('input');
              input.type = (field === 'inventory_name' ? 'text' : 'number');
              input.value = originalValue;
              input.className = 'editable-input';
              if (field === 'inventory_name') input.style.width = '200px';
              
              this.innerHTML = '';
              this.appendChild(input);
              input.focus();

              const save = async () => {
                  const newValue = input.value;
                  if (newValue === originalValue) {
                      this.innerHTML = `<span class="cell-value ${field === 'inventory_id' ? 'text-muted' : ''}" ${field === 'inventory_id' ? 'style="font-weight: 700;"' : ''}>${originalValue}</span>${field === 'inventory_price' ? ' ₽' : ''}`;
                      return;
                  }

                  try {
                      // Get other fields' values from the row
                      const newId = field === 'inventory_id' ? newValue : originalId;
                      const name = field === 'inventory_name' ? newValue : tr.querySelector('[data-field="inventory_name"] .cell-value').textContent.trim();
                      const qty = field === 'quantity_in_stock' ? newValue : tr.querySelector('[data-field="quantity_in_stock"] .cell-value').textContent.trim();
                      const price = field === 'inventory_price' ? newValue : tr.querySelector('[data-field="inventory_price"] .cell-value').textContent.trim();
                      const desc = tr.querySelector('.desc-button').getAttribute('data-desc');

                      const res = await fetch(`/admin/update-inventory/${originalId}`, {
                          method: 'PUT',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                              newId: newId,
                              inventory_name: name,
                              quantity_in_stock: qty,
                              inventory_price: price,
                              inventory_discription: desc
                          })
                      });

                      if (res.ok) {
                          this.innerHTML = `<span class="cell-value ${field === 'inventory_id' ? 'text-muted' : ''}" ${field === 'inventory_id' ? 'style="font-weight: 700;"' : ''}>${newValue}</span>${field === 'inventory_price' ? ' ₽' : ''}`;
                          if (field === 'inventory_id') {
                              tr.setAttribute('data-id', newValue);
                              tr.querySelector('.desc-button').setAttribute('data-id', newValue);
                              tr.querySelector('.delete-item-button').setAttribute('data-inventory-id', newValue);
                          }
                      } else {
                          alert('Ошибка обновления');
                          this.innerHTML = `<span class="cell-value ${field === 'inventory_id' ? 'text-muted' : ''}" ${field === 'inventory_id' ? 'style="font-weight: 700;"' : ''}>${originalValue}</span>${field === 'inventory_price' ? ' ₽' : ''}`;
                      }
                  } catch (e) {
                      console.error(e);
                      this.innerHTML = `<span class="cell-value ${field === 'inventory_id' ? 'text-muted' : ''}" ${field === 'inventory_id' ? 'style="font-weight: 700;"' : ''}>${originalValue}</span>${field === 'inventory_price' ? ' ₽' : ''}`;
                  }
              };

              input.onblur = save;
              input.onkeydown = (e) => { if (e.key === 'Enter') input.blur(); };
          });
      });

      // Description modal logic
      document.querySelectorAll('.desc-button').forEach(btn => {
          btn.addEventListener('click', () => {
              currentEditingId = btn.getAttribute('data-id');
              descTextarea.value = btn.getAttribute('data-desc') || '';
              descPopup.style.display = 'block';
          });
      });

      closeDesc.onclick = () => { descPopup.style.display = 'none'; };
      
      saveDescBtn.onclick = async () => {
          if (!currentEditingId) return;
          const newDesc = descTextarea.value;
          const tr = document.querySelector(`tr[data-id="${currentEditingId}"]`);
          const name = tr.querySelector('[data-field="inventory_name"] .cell-value').textContent.trim();
          const qty = tr.querySelector('[data-field="quantity_in_stock"] .cell-value').textContent.trim();
          const price = tr.querySelector('[data-field="inventory_price"] .cell-value').textContent.trim();

          try {
              const res = await fetch(`/admin/update-inventory/${currentEditingId}`, {
                  method: 'PUT',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                      newId: currentEditingId,
                      inventory_name: name,
                      quantity_in_stock: qty,
                      inventory_price: price,
                      inventory_discription: newDesc
                  })
              });

              if (res.ok) {
                  const btn = tr.querySelector('.desc-button');
                  btn.setAttribute('data-desc', newDesc);
                  descPopup.style.display = 'none';
                  alert('Описание сохранено');
              } else {
                  alert('Ошибка сохранения описания');
              }
          } catch (e) {
              console.error(e);
              alert('Ошибка сервера');
          }
      };

      // ===== 4. ADMIN TICKET SYSTEM SCRIPTS =====
      (function() {
        const ticketsGrid = document.getElementById('ticketsGrid');
        const windowsRoot = document.getElementById('adminChatWindows');
        const openTickets = new Map(); // customerId -> { el, lastId }

        function escapeHtml(t) { return t ? t.toString().replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : ''; }
        function formatTime(dt) { return new Date(dt).toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'}); }

        function loadTickets() {
            fetch('/chat/admin/users')
                .then(r => r.json())
                .then(users => {
                    if (!Array.isArray(users) || users.length === 0) {
                        ticketsGrid.innerHTML = '<div style="padding:16px; color:rgba(255,255,255,0.4); text-align:center; grid-column:1/-1;">Нет активных диалогов</div>';
                        return;
                    }
                    ticketsGrid.innerHTML = '';
                    users.forEach((u, index) => {
                        const btn = document.createElement('div');
                        btn.className = 'ticket-card';
                        if (u.unread_count > 0) btn.classList.add('has-unread');
                        btn.innerHTML = `
                            <div class="ticket-status"></div>
                            <div class="ticket-title">Тикет #${index + 1}</div>
                            <div class="ticket-user">${escapeHtml(u.first_name + ' ' + u.last_name)}</div>
                            <div class="ticket-preview">${escapeHtml(u.last_message || '...')}</div>
                            ${u.unread_count > 0 ? `<div class="ticket-unread">${u.unread_count}</div>` : ''}
                            <button class="ticket-delete-btn" data-cid="${u.customer_id}" title="Удалить тикет">🗑️</button>
                        `;
                        btn.onclick = (e) => {
                            if (e.target.classList.contains('ticket-delete-btn')) {
                                deleteTicket(u.customer_id);
                            } else {
                                openTicketWindow(u);
                            }
                        };
                        ticketsGrid.appendChild(btn);
                    });
                });
        }

        function openTicketWindow(user) {
            const cid = user.customer_id;
            if (openTickets.has(cid)) {
                openTickets.get(cid).el.scrollIntoView({ behavior: 'smooth', block: 'end' });
                return;
            }

            const win = document.createElement('div');
            win.className = 'admin-floating-chat';
            win.innerHTML = `
                <div class="chat-win-header">
                    <div style="flex:1; min-width:0;">
                        <div class="chat-win-title">Тикет: ${escapeHtml(user.first_name + ' ' + user.last_name)}</div>
                        <div class="chat-win-subtitle">${user.phone || ''} | ${user.email || ''}</div>
                    </div>
                    <button type="button" class="chat-win-close" title="Закрыть">&times;</button>
                </div>
                <div class="chat-win-messages"></div>
                <div class="chat-win-input-area">
                    <input type="text" placeholder="Ответить..." />
                    <button>➤</button>
                </div>
            `;

            windowsRoot.appendChild(win);
            const msgBox = win.querySelector('.chat-win-messages');
            const input  = win.querySelector('input');
            const btn    = win.querySelector('button');
            
            const ticketData = { el: win, lastId: 0, msgBox };
            openTickets.set(cid, ticketData);

            const closeBtn = win.querySelector('.chat-win-close');
            closeBtn.onclick = () => {
                win.classList.add('closing');
                setTimeout(() => {
                    win.remove();
                    openTickets.delete(cid);
                }, 200);
            };

            btn.onclick = () => sendMessage(cid, input, ticketData);
            input.onkeydown = (e) => { if(e.key === 'Enter') sendMessage(cid, input, ticketData); };

            loadMessages(cid, ticketData);
        }

        function appendMsg(ticket, msg) {
            const wrap = document.createElement('div');
            wrap.className = 'chat-message ' + (msg.sender === 'admin' ? 'user' : 'admin');
            wrap.innerHTML = `<div>${escapeHtml(msg.message)}</div><div class="chat-message-time">${formatTime(msg.created_at || new Date())}</div>`;
            ticket.msgBox.appendChild(wrap);
            ticket.msgBox.scrollTop = ticket.msgBox.scrollHeight;
            if (msg.id > ticket.lastId) ticket.lastId = msg.id;
        }

        function loadMessages(cid, ticket) {
            fetch(`/chat/admin/messages/${cid}?since=0`)
                .then(r => r.json())
                .then(msgs => {
                    if (Array.isArray(msgs)) msgs.forEach(m => appendMsg(ticket, m));
                });
        }

        function pollAll() {
            openTickets.forEach((ticket, cid) => {
                fetch(`/chat/admin/messages/${cid}?since=${ticket.lastId}`)
                    .then(r => r.json())
                    .then(msgs => {
                        if (Array.isArray(msgs)) {
                            const newMsgs = msgs.filter(m => m.id > ticket.lastId);
                            if (newMsgs.length > 0) {
                                newMsgs.forEach(m => appendMsg(ticket, m));
                                loadTickets();
                            }
                        }
                    });
            });
        }

        function sendMessage(cid, inputEl, ticket) {
            const text = inputEl.value.trim();
            if (!text) return;
            inputEl.value = '';
            fetch(`/chat/admin/send/${cid}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: text })
            })
            .then(r => r.json())
            .then(msg => {
                if (msg.id) appendMsg(ticket, { ...msg, created_at: new Date().toISOString() });
            });
        }

        function deleteTicket(cid) {
            if (!confirm('Вы уверены, что хотите удалить этот тикет и всю историю переписки?')) return;
            fetch(`/chat/admin/delete/${cid}`, { method: 'DELETE' })
                .then(r => r.ok ? r.json() : {error: 'error'})
                .then(res => {
                    if (res.ok) {
                        if (openTickets.has(cid)) {
                            openTickets.get(cid).el.remove();
                            openTickets.delete(cid);
                        }
                        loadTickets();
                    } else { alert('Ошибка при удалении тикета'); }
                });
        }

        loadTickets();
        setInterval(loadTickets, 10000);
        setInterval(pollAll, 3000);
      })();

      // ===== 5. TAB SWITCHING LOGIC =====
      document.querySelectorAll('.tab-btn').forEach(button => {
        button.addEventListener('click', () => {
          const tabName = button.getAttribute('data-tab');
          document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');
          document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));
          document.getElementById(`${tabName}-tab`).classList.add('active');
        });
      });

      // Global window click for popups
      window.addEventListener('click', (e) => {
          if (e.target == addItemPopup) addItemPopup.style.display = "none";
          if (e.target == descPopup) descPopup.style.display = "none";
      });
    </script>
  </body>
</html>

