<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&family=JetBrains+Mono:wght@500&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/css/1style.css">
    <title>Заказ #<%= servis_orders.order_id %> | Car Service</title>
    <style>
        .order-details-container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 40px;
            background: var(--card-bg);
            backdrop-filter: blur(15px);
            border: 1px solid var(--glass-border);
            border-radius: 30px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .details-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 40px;
            border-bottom: 2px solid var(--glass-border);
            padding-bottom: 20px;
        }

        .order-id {
            font-family: var(--font-display);
            font-size: 2.5rem;
            color: white;
            margin: 0;
        }

        .status-pill {
            padding: 8px 20px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-pill.active {
            background: rgba(108, 99, 255, 0.2);
            color: #6C63FF;
            border: 1px solid rgba(108, 99, 255, 0.3);
        }

        .status-pill.closed {
            background: rgba(40, 167, 69, 0.2);
            color: #28a745;
            border: 1px solid rgba(40, 167, 69, 0.3);
        }

        .status-pill.danger {
            background: rgba(220, 53, 69, 0.2);
            color: #dc3545;
            border: 1px solid rgba(220, 53, 69, 0.3);
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            margin-bottom: 40px;
        }

        .info-box {
            background: rgba(0, 0, 0, 0.2);
            padding: 25px;
            border-radius: 20px;
            border: 1px solid var(--glass-border);
        }

        .info-box h3 {
            font-family: var(--font-display);
            font-size: 0.9rem;
            color: var(--accent-color);
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 1rem;
        }

        .info-label {
            color: var(--text-muted);
        }

        .info-value {
            font-weight: 600;
            color: white;
        }

        .services-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .services-table th {
            text-align: left;
            padding: 15px;
            color: var(--text-muted);
            font-size: 0.8rem;
            text-transform: uppercase;
            border-bottom: 1px solid var(--glass-border);
        }

        .services-table td {
            padding: 15px;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .total-box {
            margin-top: 40px;
            text-align: right;
            padding: 30px;
            background: linear-gradient(90deg, transparent, rgba(255, 174, 82, 0.1));
            border-radius: 20px;
            border: 1px solid rgba(255, 174, 82, 0.2);
        }

        .total-label {
            font-size: 1.1rem;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .total-value {
            font-family: var(--font-display);
            font-size: 2.22rem;
            color: var(--accent-color);
        }

        .btn-back {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            margin-bottom: 20px;
            transition: var(--transition);
        }

        .btn-back:hover {
            color: white;
            transform: translateX(-5px);
        }

        .master-card {
            display: flex;
            align-items: center;
            gap: 20px;
            background: rgba(108, 99, 255, 0.05);
            padding: 20px;
            border-radius: 15px;
            border: 1px solid rgba(108, 99, 255, 0.1);
            margin-top: 20px;
        }

        .master-icon {
            font-size: 2rem;
            background: rgba(108, 99, 255, 0.2);
            width: 60px;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }

        @media (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
            .order-details-container {
                padding: 20px;
                margin: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="container" style="margin-top: 40px;">
        <a href="/account" class="btn-back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
            Вернуться в кабинет
        </a>

        <div class="order-details-container">
            <div class="details-header">
                <div>
                    <h1 class="order-id">Заказ #<%= servis_orders.order_id %></h1>
                    <p style="color: var(--text-muted); margin-top: 10px;">Оформлен: <%= servis_orders.servis_data %></p>
                </div>
                <div class="status-pill <%= 
                    (servis_orders.order_status === 'Заказ выполнен' || servis_orders.order_status === 'closed') ? 'closed' : 
                    (servis_orders.order_status === 'Заказ отменён' ? 'danger' : 'active') 
                %>">
                    <%= servis_orders.order_status || 'В обработке' %>
                </div>
            </div>

            <div class="info-grid">
                <!-- Car Info -->
                <div class="info-box">
                    <h3>Автомобиль</h3>
                    <div class="info-row">
                        <span class="info-label">Марка</span>
                        <span class="info-value"><%= car ? car.mark : 'Не указана' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Модель</span>
                        <span class="info-value"><%= car ? car.model : 'Не указана' %></span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Год</span>
                        <span class="info-value"><%= car ? car.year : 'Не указан' %></span>
                    </div>
                </div>

                <!-- Master Info -->
                <div class="info-box">
                    <h3>Исполнитель</h3>
                    <% if (typeof master !== 'undefined' && master) { %>
                        <div class="info-row">
                            <span class="info-label">Мастер</span>
                            <span class="info-value"><%= master.first_name %> <%= master.last_name %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Телефон</span>
                            <span class="info-value"><%= master.phone || 'Не указан' %></span>
                        </div>

                    <% } else { %>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Мастер будет назначен в ближайшее время</p>
                    <% } %>
                </div>
            </div>

            <div class="info-box" style="margin-bottom: 30px;">
                <h3>Услуги</h3>
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Кол-во</th>
                            <th style="text-align: right;">Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% services.forEach(item => { %>
                        <tr>
                            <td class="info-value"><%= item.servis_name %></td>
                            <td><%= item.quantity %></td>
                            <td style="text-align: right;" class="info-value"><%= item.servis_price %> ₽</td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <% if (parts && parts.length > 0) { %>
            <div class="info-box">
                <h3>Запчасти</h3>
                <table class="services-table">
                    <thead>
                        <tr>
                            <th>Наименование</th>
                            <th>Кол-во</th>
                            <th style="text-align: right;">Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% parts.forEach(item => { %>
                        <tr>
                            <td class="info-value"><%= item.inventory_name %></td>
                            <td><%= item.quantity %></td>
                            <td style="text-align: right;" class="info-value"><%= item.inventory_price %> ₽</td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>

            <div class="total-box">
                <div class="total-label">Итого к оплате</div>
                <div class="total-value"><%= servis_orders.total_amount %> ₽</div>
            </div>
        </div>
    </div>
</body>
</html>
